ENVIRONMENT=local   # ex: production
DEBUG=true
ENABLE_DEBUG_ROUTES=true
METRICS_ENABLED=true

# Leave LOG_FILE unset in Docker so stdout rotation handles logs
LOG_LEVEL=INFO
LOG_FULL_STACK=false
# LOG_FILE=

# frontend routing 
# must NOT be http://localhost:8001 in production
VITE_API_URL=http://localhost:8001/api/v1
FRONTEND_URL=http://127.0.0.1:5173
BACKEND_URL=http://localhost:8001/api/v1

# prod: set true with https configured
COOKIE_SECURE=false
# prod: replace with VM public ip
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

SECRET_KEY=REPLACE_WITH_64_CHAR_HEX_SECRET_ABCDEFGHIJKLMOPQRSTUVWXYZ
ORBIT_AUTH_SECRET=REPLACE_WITH_64_CHAR_HEX_SECRET_ABCDEFGHIJKLMOPQRSTUVWXYZ
ORBIT_ANONYMIZATION_SECRET=REPLACE_WITH_64_CHAR_HEX_SECRET_ABCDEFGHIJKLMOPQRSTUVWXYZ

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=orbit
DB_DRIVER=postgresql+psycopg

DB_USER=orbit_app
DB_PASSWORD=orbit_password
POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin_password

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Resend API for sending links to email
RESEND_API_KEY=
RESEND_FROM_EMAIL=Orbit <onboarding@resend.dev>


# OAuth client downloaded from Google Cloud Console (never commit this file)
GOOGLE_CLIENT_SECRETS_FILE=credentials.json

# Fernet key that encrypts advisors' Google OAuth tokens in the database (local-only value;
# staging/production refuse to start with it).
# Generate one with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GOOGLE_TOKEN_ENCRYPTION_KEY=
