DB_NAME=orbit_db
DB_USER=orbit_app
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DRIVER=postgresql+psycopg

POSTGRES_USER=postgres
POSTGRES_PASSWORD=test_admin_password

DB_DRIVER=postgresql+psycopg

# App
ENVIRONMENT=local
DEBUG=true
SECRET_KEY=local-only-insecure-secret
ORBIT_ANONYMIZATION_SECRET=Supercalifragilisticexpialidocious
ORBIT_AUTH_SECRET=Supercalifragilisticexpialidociousauth
# Resend API for sending links to email
RESEND_API_KEY=
RESEND_FROM_EMAIL=Orbit <onboarding@resend.dev>

# Public URL of the FastAPI backend (used for the Google OAuth redirect URI)
BACKEND_URL=http://localhost:8001

# OAuth client downloaded from Google Cloud Console (never commit this file)
GOOGLE_CLIENT_SECRETS_FILE=credentials.json

# Fernet key that encrypts advisors' Google OAuth tokens in the database (local-only value;
# staging/production refuse to start with it).
# Generate one with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Frontend App
VITE_API_URL=http://127.0.0.1:8001
FRONTEND_URL=http://127.0.0.1:5173

