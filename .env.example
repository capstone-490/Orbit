ENVIRONMENT=local   # ex: production
DEBUG=true
ENABLE_DEBUG_ROUTES=true
METRICS_ENABLED=true

# Leave LOG_FILE unset in Docker so stdout rotation handles logs
LOG_LEVEL=INFO
LOG_FULL_STACK=false
# LOG_FILE=

# frontend routing 
# must NOT be http://localhost:8001 in production
VITE_API_URL=http://localhost:8001/api/v1

# prod: set true with https configured
COOKIE_SECURE=false
# prod: replace with VM public ip
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

SECRET_KEY=REPLACE_WITH_64_CHAR_HEX_SECRET_ABCDEFGHIJKLMOPQRSTUVWXYZ
ORBIT_AUTH_SECRET=REPLACE_WITH_64_CHAR_HEX_SECRET_ABCDEFGHIJKLMOPQRSTUVWXYZ
ORBIT_ANONYMIZATION_SECRET=REPLACE_WITH_64_CHAR_HEX_SECRET_ABCDEFGHIJKLMOPQRSTUVWXYZ

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=orbit
DB_DRIVER=postgresql+psycopg

DB_USER=orbit_app
DB_PASSWORD=orbit_password
POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin_password

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Resend API for sending links to email
RESEND_API_KEY=
RESEND_FROM_EMAIL=Orbit <onboarding@resend.dev>

OPENFGA_API_URL=http://openfga:8080
